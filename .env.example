# Cadena de conexión a PostgreSQL (solo servidor).
# Local (docker compose): postgresql://taller:taller@localhost:5432/taller
# Producción: la URL PÚBLICA de Railway (DATABASE_PUBLIC_URL).
DATABASE_URL=postgresql://taller:taller@localhost:5432/taller

# Cadena aleatoria larga para los hashes de tokens y para cifrar los PIN.
# Genera una con: openssl rand -base64 48
TOKEN_PEPPER=

SESSION_COOKIE_NAME=taller_session
